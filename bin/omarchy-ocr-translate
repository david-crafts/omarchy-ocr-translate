#!/usr/bin/env bash
# Dispatcher: parse language/provider, then exec bin/providers/<name>.
# stdin = source text; stdout = translation only. See README "Adding another
# translation provider".
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LANGS_TSV="$ROOT/languages.tsv"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/ocr-translate"
LANG_FILE="$CONFIG_DIR/languages.env"
PROVIDER_FILE="$CONFIG_DIR/provider"

DEFAULT_FROM="en"
DEFAULT_TO="zh-CN"
DEFAULT_PROVIDER="deepseek"

FROM=""
TO=""
PROVIDER=""

usage() {
  cat <<EOF
Usage: omarchy-ocr-translate [--from LANG] [--to LANG] [--provider NAME]

Read source text on stdin and write only the translation on stdout.

  --from LANG       Source language code (default: $DEFAULT_FROM, or $LANG_FILE)
  --to LANG         Target language code (default: $DEFAULT_TO, or $LANG_FILE)
  --provider NAME   Provider script under $ROOT/providers/ (default: $DEFAULT_PROVIDER)

Language codes are listed in $LANGS_TSV.
Provider is also read from $PROVIDER_FILE (single line) when --provider is omitted.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      [[ $# -ge 2 ]] || { echo "missing value for --from" >&2; exit 1; }
      FROM=$2
      shift 2
      ;;
    --to)
      [[ $# -ge 2 ]] || { echo "missing value for --to" >&2; exit 1; }
      TO=$2
      shift 2
      ;;
    --provider)
      [[ $# -ge 2 ]] || { echo "missing value for --provider" >&2; exit 1; }
      PROVIDER=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

load_kv() {
  local file=$1 key=$2
  [[ -f $file ]] || return 0
  awk -F= -v k="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    $1 == k { sub(/^[^=]+=/, ""); gsub(/\r/, ""); print; exit }
  ' "$file"
}

if [[ -z $FROM ]]; then
  FROM=$(load_kv "$LANG_FILE" FROM || true)
fi
if [[ -z $TO ]]; then
  TO=$(load_kv "$LANG_FILE" TO || true)
fi
FROM=${FROM:-$DEFAULT_FROM}
TO=${TO:-$DEFAULT_TO}

if [[ -z $PROVIDER && -f $PROVIDER_FILE ]]; then
  PROVIDER=$(head -n1 "$PROVIDER_FILE" | tr -d '[:space:]')
fi
PROVIDER=${PROVIDER:-$DEFAULT_PROVIDER}

if [[ ! $PROVIDER =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "invalid provider name: $PROVIDER" >&2
  exit 2
fi

lang_name() {
  local code=$1
  awk -F'\t' -v c="$code" '
    /^[[:space:]]*#/ { next }
    NF < 2 { next }
    $1 == c { print $2; found=1; exit }
    END { if (!found) exit 1 }
  ' "$LANGS_TSV"
}

FROM_NAME=$(lang_name "$FROM") || { echo "unknown source language: $FROM" >&2; exit 1; }
TO_NAME=$(lang_name "$TO") || { echo "unknown target language: $TO" >&2; exit 1; }

script="$ROOT/providers/$PROVIDER"
if [[ ! -x $script ]]; then
  echo "unknown or non-executable provider: $PROVIDER ($script)" >&2
  exit 2
fi

export OCR_TRANSLATE_FROM="$FROM"
export OCR_TRANSLATE_TO="$TO"
export OCR_TRANSLATE_FROM_NAME="$FROM_NAME"
export OCR_TRANSLATE_TO_NAME="$TO_NAME"

exec "$script" --from "$FROM" --to "$TO"
